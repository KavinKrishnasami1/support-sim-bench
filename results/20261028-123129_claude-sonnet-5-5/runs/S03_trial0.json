   "args": {
    "ticket_id": "T-6003",
    "status": "pending_approval",
    "note": "eng-deploy-tools is effectively privileged (nested in release-operators -> prod-admins). Manager approval APR-3102 valid. Security approval requested from E1020 (APR-4001), pending. No access added yet."
   },
   "result": {
