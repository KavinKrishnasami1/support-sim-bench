   },
   "is_error": false
  },
  {
   "role": "tool",
   "name": "issue_credit",
   "args": {
    "customer_id": "D206",
    "amount": 3.0,
    "reason": "missing_item",
    "order_id": "Q-7601",
    "item_ids": [
     "Q-7601-1"
    ]
   },
