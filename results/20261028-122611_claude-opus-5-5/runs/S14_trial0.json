  },
  {
   "role": "tool",
   "name": "update_ticket",
   "args": {
    "ticket_id": "T-6014",
    "status": "pending_approval",
    "note": "Employee asked for temporary one-week approve access while keeping submit. Declined; SoD exception APR-4001 (E1020) still pending. Employee keeps ap-payments-submit at her request."
   },
   "result": {
    "ticket_id": "T-6014",
    "status": "pending_approval"
